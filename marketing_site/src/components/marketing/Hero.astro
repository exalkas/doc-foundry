---
import Button from '../ui/Button.astro';
---

<section class="relative overflow-hidden bg-white py-24 sm:py-32 dark:bg-slate-900">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-6xl dark:text-slate-100">
        Forge any document into clean, usable data.
      </h1>
      <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-400">
        Turn unstructured documents (PDFs, images, receipts, invoices, contracts, shipping docs, CVs, forms, scans) into structured data using customizable extraction templates, with APIs, webhooks, and automation platform integrations.
      </p>
      <div class="mt-10 flex items-center justify-center gap-x-6">
        <Button href="/register" variant="primary" class="px-6 py-3 text-base">
          Start free trial
        </Button>
        <Button href="/features" variant="outline" class="px-6 py-3 text-base">
          Learn more
        </Button>
      </div>
    </div>
  </div>
</section>

