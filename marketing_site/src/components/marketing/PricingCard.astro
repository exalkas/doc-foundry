---
import Button from '../ui/Button.astro';

interface Props {
  planId: string;
  name: string;
  price: string;
  interval: string;
  features: string[];
  highlighted?: boolean;
}

const { planId, name, price, interval, features, highlighted = false } = Astro.props;
---

<div 
  class={`flex flex-col h-full rounded-lg border p-8 cursor-pointer transition-all hover:shadow-lg pricing-card ${highlighted ? 'border-[#2563EB] bg-slate-50 dark:border-[#2563EB] dark:bg-slate-800' : 'border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900'}`}
  data-plan-id={planId}
  data-selected={highlighted ? 'true' : 'false'}
>
  <div class="flex items-center justify-between">
    <h3 class="text-xl font-semibold text-slate-900 dark:text-slate-100">{name}</h3>
    {highlighted && (
      <span class="rounded-full bg-[#2563EB] px-3 py-1 text-xs font-medium text-white">
        Popular
      </span>
    )}
  </div>
  <div class="mt-4">
    {price === "Custom" ? (
      <span class="text-4xl font-bold text-slate-900 dark:text-slate-100">{price}</span>
    ) : (
      <>
        <span class="text-4xl font-bold text-slate-900 dark:text-slate-100">${price}</span>
        <span class="text-sm text-slate-600 dark:text-slate-400">/{interval}</span>
      </>
    )}
  </div>
  <ul class="mt-6 flex-1 space-y-3">
    {features.map((feature) => (
      <li class="flex items-start gap-2">
        <svg class="h-5 w-5 flex-shrink-0 text-[#22C55E]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-sm text-slate-600 dark:text-slate-400">{feature}</span>
      </li>
    ))}
  </ul>
  <div class="mt-auto pt-8" onclick="event.stopPropagation()">
    <Button 
      href={planId === "enterprise" ? "/contact" : `/register?plan=${planId}`} 
      variant={highlighted ? 'primary' : 'outline'}
      class="w-full"
    >
      {planId === "enterprise" ? "Contact Sales" : "Get started"}
    </Button>
  </div>
</div>

