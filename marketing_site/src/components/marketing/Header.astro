---
import Button from '../ui/Button.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';

// Determine main app URL based on environment
const appUrl = import.meta.env.PUBLIC_APP_URL || (import.meta.env.DEV ? 'http://localhost:3000/app' : '/app');
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/60 dark:border-slate-800 dark:bg-slate-900/95">
  <nav class="container mx-auto flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2 text-xl font-semibold text-slate-900 dark:text-slate-100">
        <img src="/assets/logos/logo-docfoundry-icon.svg" alt="DocFoundry.app" class="h-8 w-8" />
        <span class="text-primary">DocFoundry.app</span>
      </a>
      <div class="hidden items-center gap-6 md:flex">
        <a href="/features" class="text-sm font-medium text-slate-600 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">
          Features
        </a>
        <a href="/pricing" class="text-sm font-medium text-slate-600 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">
          Pricing
        </a>
        <a href="/contact" class="text-sm font-medium text-slate-600 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">
          Contact
        </a>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <ThemeToggle />
      <div class="hidden items-center gap-4 sm:flex">
        <a href={appUrl} class="text-sm font-medium text-slate-600 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">
          Sign in
        </a>
        <Button href="/register" variant="primary">
          Start free trial
        </Button>
      </div>
      <button
        class="flex h-9 w-9 items-center justify-center rounded-md border border-slate-200 text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100 md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        id="mobile-menu-toggle"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  if (typeof document !== 'undefined') {
    const toggle = document.getElementById('mobile-menu-toggle');
    if (toggle) {
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        // Mobile menu implementation would go here
      });
    }
  }
</script>

