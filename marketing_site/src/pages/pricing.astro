---
import Layout from '../layouts/Layout.astro';
import Header from '../components/marketing/Header.astro';
import Footer from '../components/marketing/Footer.astro';
import PricingCard from '../components/marketing/PricingCard.astro';
---

<Layout title="Pricing - DocFoundry.app" description="Choose the plan that fits your document processing needs.">
  <Header />
  <main>
    <section class="py-24 sm:py-32 bg-white dark:bg-slate-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100">
            Simple, transparent pricing
          </h1>
          <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">
            Choose the plan that fits your document processing needs. All plans include API & webhook access.
          </p>
        </div>
        <div class="mx-auto mt-16 max-w-7xl">
          <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4" id="pricing-cards">
            <PricingCard
              planId="free"
              name="Free"
              price="0"
              interval="month"
              features={[
                'Up to 100 pages per month',
                '1 team member',
                'Up to 3 extraction templates',
                '1 project',
                'Email support',
                'API access',
              ]}
            />
            <PricingCard
              planId="basic"
              name="Basic"
              price="29"
              interval="month"
              features={[
                'Up to 1,000 pages per month',
                '1 team member',
                'Up to 5 extraction templates',
                'Email support',
                'API & webhook access',
              ]}
            />
            <PricingCard
              planId="pro"
              name="Pro"
              price="99"
              interval="month"
              highlighted={true}
              features={[
                'Up to 10,000 pages per month',
                '5 team members',
                'Unlimited extraction templates',
                'Priority support',
                'API & webhook access',
                'Zapier/Make/n8n integrations',
              ]}
            />
            <PricingCard
              planId="enterprise"
              name="Enterprise"
              price="Custom"
              interval="pricing"
              features={[
                'Unlimited pages',
                'Unlimited team members',
                'Unlimited extraction templates',
                'Unlimited projects',
                'Dedicated support',
                'SSO & custom branding',
                'Custom integrations',
                'SLA guarantee',
                '10-year data retention',
              ]}
            />
          </div>
        </div>
        
        <!-- Partner Program Section -->
        <div class="mx-auto mt-24 max-w-4xl">
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-8 dark:border-slate-700 dark:bg-slate-800">
            <div class="text-center mb-6">
              <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">
                Partner Program – Earn Recurring Revenue
              </h2>
              <p class="text-slate-600 dark:text-slate-400">
                If you help others automate document processing, you can earn money by recommending DocFoundry.app.
              </p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
              <div>
                <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2">Commission Structure</h3>
                <ul class="text-sm text-slate-600 dark:text-slate-400 space-y-1">
                  <li><strong>20% recurring commission</strong> for <strong>12 months</strong> on every customer you refer</li>
                  <li>Earn from initial subscription + renewals + upgrades</li>
                  <li>Bonus: Top-performing partners unlock <strong>30% VIP commissions</strong></li>
                </ul>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2">Who can join?</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400">
                  Developers, automation specialists (Make.com, n8n, Zapier), agencies, bookkeepers, SaaS creators, and content creators.
                </p>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2">Payouts</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400">
                  Paid via PayPal or Wise once your balance reaches €50.
                </p>
              </div>
            </div>
            
            <div class="text-center">
              <a href="/partners" class="inline-block px-6 py-3 bg-primary text-white rounded-md hover:bg-primary-dark transition-colors font-medium">
                Learn more & join the Partner Program
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // Handle pricing card selection
  if (typeof document !== 'undefined') {
    const cards = document.querySelectorAll('.pricing-card');
    
    function updateCardStyles(card, isSelected) {
      if (isSelected) {
        card.setAttribute('data-selected', 'true');
        card.classList.remove('border-slate-200', 'bg-white', 'dark:border-slate-700', 'dark:bg-slate-900');
        card.classList.add('border-[#2563EB]', 'bg-slate-50', 'dark:border-[#2563EB]', 'dark:bg-slate-800');
        
        // Update button to primary variant
        const button = card.querySelector('a[href*="/register"]');
        if (button) {
          button.classList.remove('border', 'border-slate-200', 'bg-transparent', 'hover:bg-slate-100', 'dark:border-slate-800', 'dark:hover:bg-slate-800', 'text-slate-900', 'dark:text-slate-100');
          button.classList.add('bg-[#2563EB]', 'text-white', 'hover:bg-[#1d4ed8]', 'dark:bg-[#2563EB]', 'dark:hover:bg-[#1d4ed8]');
        }
      } else {
        card.setAttribute('data-selected', 'false');
        card.classList.remove('border-[#2563EB]', 'bg-slate-50', 'dark:border-[#2563EB]', 'dark:bg-slate-800');
        card.classList.add('border-slate-200', 'bg-white', 'dark:border-slate-700', 'dark:bg-slate-900');
        
        // Update button to outline variant
        const button = card.querySelector('a[href*="/register"]');
        if (button) {
          button.classList.remove('bg-[#2563EB]', 'text-white', 'hover:bg-[#1d4ed8]', 'dark:bg-[#2563EB]', 'dark:hover:bg-[#1d4ed8]');
          button.classList.add('border', 'border-slate-200', 'bg-transparent', 'hover:bg-slate-100', 'dark:border-slate-800', 'dark:hover:bg-slate-800', 'text-slate-900', 'dark:text-slate-100');
        }
      }
    }
    
    cards.forEach((card) => {
      // Handle card click (but not button clicks)
      card.addEventListener('click', (e) => {
        // Don't select if clicking on the button or its container
        if (e.target.closest('a[href*="/register"]') || e.target.closest('button') || e.target.closest('div[onclick]')) {
          return;
        }
        
        // Remove selection from all cards
        cards.forEach((c) => {
          updateCardStyles(c, false);
        });
        
        // Select clicked card
        updateCardStyles(card, true);
      });
    });
  }
</script>

