{
  "entities": [
    {
      "name": "User",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        { "name": "email", "type": "string", "required": true, "unique": true, "max_length": 255 },
        { "name": "password_hash", "type": "string", "required": true },
        {
          "name": "global_role",
          "type": "enum",
          "required": true,
          "values": ["admin", "user"],
          "default": "user",
          "description": "Platform-wide role; workspace-specific role lives on WorkspaceMember"
        },
        { "name": "full_name", "type": "string", "required": false, "max_length": 255 },
        { "name": "is_email_verified", "type": "boolean", "required": true, "default": false },
        {
          "name": "auth_provider",
          "type": "enum",
          "required": true,
          "values": ["local", "google"],
          "default": "local"
        },
        { "name": "last_login_at", "type": "datetime", "required": false },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" },
        { "name": "updated_at", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "Workspace",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        { "name": "name", "type": "string", "required": true, "max_length": 255 },
        {
          "name": "owner_user_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "User.id"
        },
        { "name": "stripe_customer_id", "type": "string", "required": false, "max_length": 255 },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "values": ["active", "suspended", "trial", "canceled"],
          "default": "trial"
        },
        { "name": "trial_ends_at", "type": "datetime", "required": false },
        { "name": "primary_color", "type": "string", "required": false, "max_length": 32 },
        { "name": "logo_url", "type": "string", "required": false },
        { "name": "custom_domain", "type": "string", "required": false, "unique": true },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" },
        { "name": "updated_at", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "WorkspaceMember",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "Workspace.id"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "User.id"
        },
        {
          "name": "role",
          "type": "enum",
          "required": true,
          "values": ["owner", "member", "readonly"]
        },
        { "name": "invited_at", "type": "datetime", "required": true },
        { "name": "joined_at", "type": "datetime", "required": false },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "values": ["pending", "active", "revoked"],
          "default": "pending"
        },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" },
        { "name": "updated_at", "type": "datetime", "required": true, "default": "now" }
      ],
      "unique_constraints": [
        { "fields": ["workspace_id", "user_id"] }
      ]
    },
    {
      "name": "Subscription",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "Workspace.id"
        },
        {
          "name": "stripe_subscription_id",
          "type": "string",
          "required": true,
          "max_length": 255,
          "unique": true
        },
        {
          "name": "plan_id",
          "type": "enum",
          "required": true,
          "values": ["basic", "pro"]
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "values": ["active", "past_due", "canceled", "trialing"]
        },
        { "name": "current_period_start", "type": "datetime", "required": true },
        { "name": "current_period_end", "type": "datetime", "required": true },
        { "name": "cancel_at_period_end", "type": "boolean", "required": true, "default": false },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" },
        { "name": "updated_at", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "UsageRecord",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "Workspace.id"
        },
        { "name": "date", "type": "date", "required": true },
        { "name": "documents_processed", "type": "int", "required": true, "default": 0 },
        { "name": "pages_processed", "type": "int", "required": true, "default": 0 },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" }
      ],
      "unique_constraints": [
        { "fields": ["workspace_id", "date"] }
      ]
    },
    {
      "name": "Project",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "Workspace.id"
        },
        { "name": "name", "type": "string", "required": true, "max_length": 255 },
        { "name": "description", "type": "string", "required": false },
        {
          "name": "created_by_user_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "User.id"
        },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" },
        { "name": "updated_at", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "Template",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "Workspace.id",
          "index": true
        },
        {
          "name": "project_id",
          "type": "uuid",
          "required": false,
          "foreign_key": "Project.id",
          "index": true
        },
        { "name": "name", "type": "string", "required": true, "max_length": 255 },
        { "name": "description", "type": "string", "required": false },
        { "name": "document_type", "type": "string", "required": false, "max_length": 128 },
        {
          "name": "field_schema",
          "type": "json",
          "required": true,
          "description": "Array/object describing fields: name, json_key, type, required, validation, etc."
        },
        {
          "name": "default_export_format",
          "type": "enum",
          "required": true,
          "values": ["json", "csv", "excel"],
          "default": "json"
        },
        {
          "name": "created_by_user_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "User.id"
        },
        { "name": "last_run_at", "type": "datetime", "required": false },
        { "name": "success_count", "type": "int", "required": true, "default": 0 },
        { "name": "failure_count", "type": "int", "required": true, "default": 0 },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" },
        { "name": "updated_at", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "Document",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "Workspace.id",
          "index": true
        },
        {
          "name": "project_id",
          "type": "uuid",
          "required": false,
          "foreign_key": "Project.id",
          "index": true
        },
        {
          "name": "template_id",
          "type": "uuid",
          "required": false,
          "foreign_key": "Template.id",
          "index": true
        },
        { "name": "file_name", "type": "string", "required": true },
        { "name": "file_type", "type": "string", "required": true, "max_length": 128 },
        { "name": "storage_path", "type": "string", "required": true },
        { "name": "pages", "type": "int", "required": false },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "values": ["pending", "processing", "succeeded", "failed"]
        },
        {
          "name": "uploaded_by_user_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "User.id"
        },
        {
          "name": "source",
          "type": "enum",
          "required": true,
          "values": ["ui", "api"]
        },
        { "name": "last_error", "type": "string", "required": false },
        { "name": "callback_url", "type": "string", "required": false },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" },
        { "name": "updated_at", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "ExtractionResult",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "document_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "Document.id",
          "index": true
        },
        {
          "name": "template_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "Template.id"
        },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "Workspace.id",
          "index": true
        },
        { "name": "extracted_json", "type": "json", "required": true },
        { "name": "version", "type": "int", "required": true, "default": 1 },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "ExtractionLog",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "document_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "Document.id",
          "index": true
        },
        {
          "name": "level",
          "type": "enum",
          "required": true,
          "values": ["info", "warning", "error"]
        },
        { "name": "message", "type": "string", "required": true },
        { "name": "metadata", "type": "json", "required": false },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "Job",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "type",
          "type": "enum",
          "required": true,
          "values": ["document_extraction", "webhook_delivery"]
        },
        { "name": "payload", "type": "json", "required": true },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "values": ["queued", "processing", "succeeded", "failed"],
          "default": "queued"
        },
        { "name": "attempts", "type": "int", "required": true, "default": 0 },
        { "name": "max_attempts", "type": "int", "required": true, "default": 5 },
        { "name": "last_error", "type": "string", "required": false },
        { "name": "scheduled_at", "type": "datetime", "required": true },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" },
        { "name": "updated_at", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "ApiKey",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "Workspace.id",
          "index": true
        },
        { "name": "name", "type": "string", "required": true, "max_length": 255 },
        { "name": "key_hash", "type": "string", "required": true },
        {
          "name": "prefix",
          "type": "string",
          "required": true,
          "max_length": 16,
          "description": "Short non-secret identifier shown in UI/logs"
        },
        {
          "name": "scopes",
          "type": "json",
          "required": true,
          "description": "Array of scope strings (e.g. ['documents:read','documents:write'])"
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "values": ["active", "revoked"],
          "default": "active"
        },
        { "name": "expires_at", "type": "datetime", "required": false },
        { "name": "last_used_at", "type": "datetime", "required": false },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "WebhookConfig",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "Workspace.id",
          "index": true
        },
        { "name": "target_url", "type": "string", "required": true },
        { "name": "secret", "type": "string", "required": true },
        {
          "name": "events",
          "type": "json",
          "required": true,
          "description": "Array of event type strings (e.g. ['extraction.completed'])"
        },
        {
          "name": "retry_policy",
          "type": "json",
          "required": true,
          "description": "Config for backoff, max attempts, etc."
        },
        { "name": "enabled", "type": "boolean", "required": true, "default": true },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" },
        { "name": "updated_at", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "WebhookDelivery",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "webhook_config_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "WebhookConfig.id",
          "index": true
        },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "Workspace.id",
          "index": true
        },
        { "name": "event_type", "type": "string", "required": true },
        { "name": "payload", "type": "json", "required": true },
        { "name": "status_code", "type": "int", "required": false },
        {
          "name": "delivery_status",
          "type": "enum",
          "required": true,
          "values": ["pending", "succeeded", "failed"],
          "default": "pending"
        },
        { "name": "attempt_count", "type": "int", "required": true, "default": 0 },
        { "name": "last_error", "type": "string", "required": false },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" },
        { "name": "updated_at", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "AuditLog",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": false,
          "foreign_key": "Workspace.id",
          "index": true
        },
        {
          "name": "user_id",
          "type": "uuid",
          "required": false,
          "foreign_key": "User.id",
          "index": true
        },
        {
          "name": "actor_type",
          "type": "enum",
          "required": true,
          "values": ["user", "system"]
        },
        { "name": "event_type", "type": "string", "required": true },
        { "name": "description", "type": "string", "required": true },
        { "name": "metadata", "type": "json", "required": false },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "Notification",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary_key": true },
        {
          "name": "user_id",
          "type": "uuid",
          "required": true,
          "foreign_key": "User.id",
          "index": true
        },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": false,
          "foreign_key": "Workspace.id"
        },
        {
          "name": "channel",
          "type": "enum",
          "required": true,
          "values": ["email", "in_app"]
        },
        {
          "name": "event_type",
          "type": "string",
          "required": true,
          "description": "Matches configured notification events (e.g. 'payment_failed')"
        },
        { "name": "payload", "type": "json", "required": true },
        { "name": "read_at", "type": "datetime", "required": false },
        { "name": "created_at", "type": "datetime", "required": true, "default": "now" }
      ]
    }
  ],
  "relationships": [
    { "from": "User", "to": "Workspace", "type": "many_to_many", "via": "WorkspaceMember" },
    { "from": "Workspace", "to": "Subscription", "type": "one_to_many" },
    { "from": "Workspace", "to": "Project", "type": "one_to_many" },
    { "from": "Workspace", "to": "Template", "type": "one_to_many" },
    { "from": "Workspace", "to": "Document", "type": "one_to_many" },
    { "from": "Workspace", "to": "ApiKey", "type": "one_to_many" },
    { "from": "Workspace", "to": "WebhookConfig", "type": "one_to_many" },
    { "from": "Workspace", "to": "UsageRecord", "type": "one_to_many" },
    { "from": "Workspace", "to": "WebhookDelivery", "type": "one_to_many" },
    { "from": "Workspace", "to": "AuditLog", "type": "one_to_many" },
    { "from": "Workspace", "to": "Notification", "type": "one_to_many" },
    { "from": "Project", "to": "Document", "type": "one_to_many" },
    { "from": "Project", "to": "Template", "type": "one_to_many" },
    { "from": "Template", "to": "Document", "type": "one_to_many" },
    { "from": "Document", "to": "ExtractionResult", "type": "one_to_many" },
    { "from": "Document", "to": "ExtractionLog", "type": "one_to_many" },
    { "from": "WebhookConfig", "to": "WebhookDelivery", "type": "one_to_many" },
    { "from": "User", "to": "Notification", "type": "one_to_many" }
  ],
  "api_endpoints": [
    {
      "id": "E_auth_login",
      "method": "POST",
      "path": "/api/auth/login",
      "request": {
        "body": {
          "type": "json",
          "fields": [
            { "name": "email", "type": "string", "required": true },
            { "name": "password", "type": "string", "required": true }
          ]
        }
      },
      "response": {
        "body": {
          "type": "json",
          "fields": [
            { "name": "token", "type": "string" },
            { "name": "user", "type": "object" },
            { "name": "workspaces", "type": "array", "items_type": "object" },
            { "name": "current_workspace", "type": "object" }
          ]
        }
      },
      "auth_required": false
    },
    {
      "id": "E_auth_register",
      "method": "POST",
      "path": "/api/auth/register",
      "request": {
        "body": {
          "type": "json",
          "fields": [
            { "name": "full_name", "type": "string", "required": false },
            { "name": "email", "type": "string", "required": true },
            { "name": "password", "type": "string", "required": true },
            { "name": "workspace_name", "type": "string", "required": true }
          ]
        }
      },
      "response": {
        "body": {
          "type": "json",
          "fields": [
            { "name": "token", "type": "string" },
            { "name": "user", "type": "object" },
            { "name": "workspace", "type": "object" }
          ]
        }
      },
      "auth_required": false
    },
    {
      "id": "E_auth_me",
      "method": "GET",
      "path": "/api/auth/me",
      "request": {
        "query": [],
        "body": null
      },
      "response": {
        "body": {
          "type": "json",
          "fields": [
            { "name": "user", "type": "object" },
            { "name": "workspaces", "type": "array", "items_type": "object" },
            { "name": "current_workspace", "type": "object" }
          ]
        }
      },
      "auth_required": true
    },
    {
      "id": "E_auth_switch_workspace",
      "method": "POST",
      "path": "/api/auth/switch-workspace",
      "request": {
        "body": {
          "type": "json",
          "fields": [
            { "name": "workspace_id", "type": "uuid", "required": true }
          ]
        }
      },
      "response": {
        "body": {
          "type": "json",
          "fields": [
            { "name": "current_workspace", "type": "object" }
          ]
        }
      },
      "auth_required": true
    },
    {
      "id": "E_projects_list",
      "method": "GET",
      "path": "/api/projects",
      "request": {
        "query": [
          { "name": "page", "type": "int", "required": false },
          { "name": "page_size", "type": "int", "required": false }
        ],
        "body": null
      },
      "response": {
        "body": {
          "type": "json",
          "fields": [
            { "name": "projects", "type": "array", "items_type": "Project" }
          ]
        }
      },
      "auth_required": true
    },
    {
      "id": "E_projects_create",
      "method": "POST",
      "path": "/api/projects",
      "request": {
        "body": {
          "type": "json",
          "fields": [
            { "name": "name", "type": "string", "required": true },
            { "name": "description", "type": "string", "required": false }
          ]
        }
      },
      "response": {
        "body": {
          "type": "json",
          "fields": [
            { "name": "project", "type": "Project" }
          ]
        }
      },
      "auth_required": true
    },
    {
      "id": "E_projects_get",
      "method": "GET",
      "path": "/api/projects/{projectId}",
      "request": {
        "path_params": [
          { "name": "projectId", "type": "uuid", "required": true }
        ],
        "query": [],
        "body": null
      },
      "response": {
        "body": {
          "type": "json",
          "fields": [
            { "name": "project", "type": "Project" }
          ]
        }
      },
      "auth_required": true
    },
    {
      "id": "E_projects_update",
      "method": "PATCH",
      "path": "/api/projects/{projectId}",
      "request": {
        "path_params": [
          { "name": "projectId", "type": "uuid", "required": true }
        ],
        "body": {
          "type": "json",
