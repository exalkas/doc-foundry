# Application Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
# For local development, use these values:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docdata_saas
DB_USER=docdata_saas
DB_PASSWORD=replace_with_local_database_password

# PostgreSQL Superuser (for local database setup)
# These credentials are used by setup_db.py to create the database and user
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=  # Set your PostgreSQL superuser password here

# For Docker deployment, DB_HOST should be 'db' (the service name)
# DB_HOST=db

# Application Settings
SECRET_KEY=replace_with_random_secret_generated_locally
DEBUG=true
ENVIRONMENT=development

# API Configuration
API_V1_PREFIX=/api/v1

# CORS — env key must match Settings: CORS_ALLOW_ORIGINS (JSON array).
# Leave unset in development to use defaults (localhost:3000, :3001, :4321).
# CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Add other environment variables as needed
